# Copy to ~/vod-fetcher/vod.env on the Pi — NEVER commit the real file
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# AI shorts clipper — optional, leave empty to disable (README → "AI shorts")
# Uses your Claude subscription through the Claude Code CLI, no API key: run `claude setup-token` on any PC
# and paste the token here. Set CLIP_ENABLED=false to turn clipping off.
CLAUDE_CODE_OAUTH_TOKEN=
MAX_CLIPS=8
CLIP_STYLE=blur
# CLIP_FRAME_INTERVAL=4
# Model: haiku (default, lightest on your plan's usage limits), sonnet or opus (sharper picks)
# CLIP_MODEL=haiku
# Instagram Reels posting — optional (README → "Instagram")
IG_ACCESS_TOKEN=
# Only for Facebook (EAA…) tokens: app id + secret (app → Settings → Basic) let the token auto-renew.
# Without them, extend it by hand every ~60 days (README → Instagram).
FB_APP_ID=
FB_APP_SECRET=
POLL_SECONDS=300
LOOKBACK_HOURS=24
# DOWNLOAD_DIR / STATE_FILE are set by docker-compose.yml (inside the container: /data/...)
# YT_COOKIES_FILE=/data/cookies.txt
# POST_DOWNLOAD_CMD=rclone copy --
