# Copy to ~/vod-fetcher/vod.env on the Pi — NEVER commit the real file
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# AI shorts clipper — optional, leave empty to disable (README → "AI shorts")
# Uses your Claude subscription through the Claude Code CLI, no API key: run `claude setup-token` on any PC
# and paste the token here. Set CLIP_ENABLED=false to turn clipping off.
CLAUDE_CODE_OAUTH_TOKEN=
MAX_CLIPS=8
# auto = Claude picks per clip: vertical (centre crop) or horizontal (whole frame on blurred background).
# crop / blur = always that style.
CLIP_STYLE=auto
# CLIP_FRAME_INTERVAL=4
# Model: haiku (default, lightest on your plan's usage limits), sonnet or opus (sharper picks)
# CLIP_MODEL=haiku
# Instagram Reels posting — optional (README → "Instagram")
IG_ACCESS_TOKEN=
# Every new clip is published as a Reel automatically (Instagram's API has no drafts).
# AUTO_POST=false → only folders with an APPROVED file get posted.
AUTO_POST=true
# Only for Facebook (EAA…) tokens: app id + secret (app → Settings → Basic) let the token auto-renew.
# Without them, extend it by hand every ~60 days (README → Instagram).
FB_APP_ID=
FB_APP_SECRET=
# Whole cycle (fetch, download, clip, post approved) runs once a day at RUN_AT in RUN_TZ.
# RUN_AT=off → poll every POLL_SECONDS instead.
RUN_AT=04:00
RUN_TZ=Europe/Warsaw
# POLL_SECONDS=300
LOOKBACK_HOURS=48
# Delete downloaded VODs this many days after download (0 = keep forever). Clips are kept.
VOD_RETENTION_DAYS=7
# Instagram: one Reel at each of these times (RUN_TZ), best clip first, oldest VOD first. off = post by hand only.
POST_TIMES=12:00,17:00,21:00
# Clips scoring under 7/10 that weren't posted this many days after the stream are skipped (0 = never).
POST_MAX_AGE_DAYS=7
# DOWNLOAD_DIR / STATE_FILE are set by docker-compose.yml (inside the container: /data/...)
# YT_COOKIES_FILE=/data/cookies.txt
# POST_DOWNLOAD_CMD=rclone copy --
